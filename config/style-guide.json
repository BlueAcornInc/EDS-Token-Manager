          "affects": ["h1–h4", "hero titles"]
        },
        "bodyFontSizeM": {
          "cssVar": "--body-font-size-m",
          "type": "string",
          "default": "18px",
          "label": "Body size M",
          "affects": ["paragraphs"]
        },
        "bodyFontSizeS": {
          "cssVar": "--body-font-size-s",
          "type": "string",
          "default": "16px",
          "label": "Body size S",
          "affects": ["secondary copy", "form labels"]
        },
        "bodyFontSizeXs": {
          "cssVar": "--body-font-size-xs",
          "type": "string",
          "default": "14px",
          "label": "Body size XS",
          "affects": ["captions", "CTA labels"]
        },
        "bodyFontSizeXxs": {
          "cssVar": "--body-font-size-xxs",
