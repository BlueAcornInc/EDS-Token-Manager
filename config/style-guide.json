        "headingFontSizeH2": {
          "cssVar": "--heading-font-size-h2",
          "type": "string",
          "default": "24px / 34px desktop",
          "label": "Heading 2 size",
          "affects": ["section titles"]
        },
        "headingFontSizeH3": {
          "cssVar": "--heading-font-size-h3",
          "type": "string",
          "default": "22px / 24px desktop",
          "label": "Heading 3 size",
          "affects": ["sub-sections", "cards"]
