    {
      "id": "typography",
      "label": "Typography",
      "editable": false,
      "preview": "typography",
      "readonlyNote": "For Reference Only! These are not brand-editable and are shared/calculated values",
      "tokens": {
        "bodyFontFamily": {
          "cssVar": "--body-font-family",
          "type": "string",
          "default": "inter, inter-fallback, sans-serif",
          "label": "Body font family",
          "affects": ["paragraphs", "lists", "forms"]
        },
        "headingFontFamily": {
          "cssVar": "--heading-font-family",
          "type": "string",
